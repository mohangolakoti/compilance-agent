# MongoDB Atlas Connection URI
MONGODB_URI=url

# Hindsight Cloud API credentials (https://ui.hindsight.vectorize.io - promo code: MEMHACK99)
HINDSIGHT_API_KEY=key
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=key
GROQ_MODEL=openai/gpt-oss-120b

# Required for production coordinator/check-in/protocol API access
COORDINATOR_API_TOKEN=replace-with-a-long-random-token

# Set these to mock only for deterministic local unit tests
HINDSIGHT_MODE=live
GROQ_MODE=live
MONGODB_MODE=live

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
